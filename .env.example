# QuickFix Environment Variables Template
# Server Secrets (DO NOT prefix with NEXT_PUBLIC_)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/quickfix?retryWrites=true&w=majority
MONGODB_DB_NAME=quickfix
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AUTH_SECRET=generate_a_random_secure_jwt_secret_minimum_32_characters

# Public Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000
